From 11cbb1badcffcfee12c6ea16a13b05b7ab216cd4 Mon Sep 17 00:00:00 2001
From: Lars Mehnen <8724643+Mehnen@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:14:41 +0100
Subject: [PATCH 4/5] OpenBSD: patch fmt/base.h to include <stdlib.h>

On OpenBSD, Clang raises a hard error for uses of malloc/free without
a prior declaration. fmt/base.h uses both but only includes <stdio.h>
and <string.h>, so the vendored {fmt} build fails with
"use of undeclared identifier 'free'".

Add a post-FetchContent cmake step that injects the missing
  #include <stdlib.h>
into the vendored fmt/base.h when building on OpenBSD.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 src/cpp/ext/CMakeLists.txt | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/cpp/ext/CMakeLists.txt b/src/cpp/ext/CMakeLists.txt
index 75b7dd6f8b..5f7ddd48cf 100644
--- a/src/cpp/ext/CMakeLists.txt
+++ b/src/cpp/ext/CMakeLists.txt
@@ -497,6 +497,25 @@ if(EXISTS "${_LIBGIT2_GIT2_H}.prev")
    endif()
 endif()
 
+# OpenBSD: fmt/base.h uses malloc/free but omits <stdlib.h>, causing build
+# failures with Clang. Patch the vendored header after FetchContent populates it.
+if(CMAKE_SYSTEM_NAME STREQUAL "OpenBSD" AND DEFINED FMT_SOURCE_DIR)
+   set(_FMT_BASE_H "${FMT_SOURCE_DIR}/include/fmt/base.h")
+   if(EXISTS "${_FMT_BASE_H}")
+      file(READ "${_FMT_BASE_H}" _FMT_BASE_H_CONTENT)
+      if(NOT _FMT_BASE_H_CONTENT MATCHES "#include <stdlib\\.h>")
+         string(REPLACE
+            "#  include <stdio.h>   // FILE"
+            "#  include <stdio.h>   // FILE\n#  include <stdlib.h>  // malloc, free"
+            _FMT_BASE_H_CONTENT "${_FMT_BASE_H_CONTENT}")
+         file(WRITE "${_FMT_BASE_H}" "${_FMT_BASE_H_CONTENT}")
+         message(STATUS "OpenBSD: patched fmt/base.h to add <stdlib.h>")
+      endif()
+      unset(_FMT_BASE_H_CONTENT)
+   endif()
+   unset(_FMT_BASE_H)
+endif()
+
 restore_global_settings()
 
 
-- 
